# LiveKit Cloud credentials
# Get these from https://cloud.livekit.io/
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# PostgreSQL database URL
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/videogenai

# JWT — set a long random string in production
JWT_SECRET=change-me-in-production

# Redis — caches in-progress interview conversations/timers so they survive
# reconnects. Defaults to localhost if unset.
REDIS_URL=redis://localhost:6379/0

# Hard cap on interview length, in seconds (default 5 minutes)
INTERVIEW_DURATION_SECONDS=300
